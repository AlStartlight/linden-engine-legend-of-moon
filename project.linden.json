      "appName": "Legend Of MOON"
    },
    {
      "id": "preset-web-html5",
      "name": "Web",
      "platform": "web",
      "backend": "linden",
      "arch": [
        "wasm"
      ],
      "output": "build/web/index.html",
      "mode": "release",
      "appName": "Legend Of MOON"
    },
    {
      "id": "preset-android",
      "name": "Android",
      "platform": "android",
      "backend": "godot",
      "arch": [
        "arm64"
      ],
      "output": "build/android/LegendOfMOON.apk",
      "mode": "debug",
      "appName": "Legend Of MOON"
    },
    {
      "id": "preset-ios",
      "name": "iOS",
      "platform": "ios",
      "backend": "godot",
      "arch": [
        "arm64"
      ],
      "output": "build/ios/LegendOfMOON.ipa",
      "mode": "debug",
      "appName": "Legend Of MOON"
    }
  ]
