  "input": {
    "actions": [
      {
        "name": "Move",
        "type": "vector2",
        "bindings": [
          "Gamepad/LeftStick",
          "Touch/Joystick"
        ],
        "composites": [
          {
            "up": [
              "Keyboard/KeyW"
            ],
            "down": [
              "Keyboard/KeyS"
            ],
            "left": [
              "Keyboard/KeyA"
            ],
            "right": [
              "Keyboard/KeyD"
            ]
          },
          {
            "up": [
              "Keyboard/ArrowUp"
            ],
            "down": [
              "Keyboard/ArrowDown"
            ],
            "left": [
              "Keyboard/ArrowLeft"
            ],
            "right": [
              "Keyboard/ArrowRight"
            ]
          }
        ],
        "deadzone": 0.15
      },
      {
        "name": "Turn",
        "type": "axis",
        "bindings": [],
        "composites": [
          {
            "negative": [
              "Keyboard/KeyQ",
              "Gamepad/LeftShoulder"
            ],
            "positive": [
              "Keyboard/KeyE",
              "Gamepad/RightShoulder"
            ]
          }
        ]
      },
      {
        "name": "Vertical",
        "type": "axis",
        "bindings": [],
        "composites": [
          {
            "negative": [
              "Keyboard/KeyQ",
              "Gamepad/LeftTrigger"
            ],
            "positive": [
              "Keyboard/KeyE",
              "Gamepad/RightTrigger"
            ]
          }
        ]
      },
      {
        "name": "Look",
        "type": "vector2",
        "bindings": [
          "Mouse/Delta",
          "Gamepad/RightStick",
          "Touch/Look"
        ],
        "deadzone": 0.15,
        "sensitivity": 1
      },
      {
        "name": "Jump",
        "type": "button",
        "bindings": [
          "Keyboard/Space",
          "Gamepad/ButtonSouth"
        ]
      },
      {
        "name": "Sprint",
        "type": "button",
        "bindings": [
          "Keyboard/ShiftLeft",
          "Gamepad/LeftStickPress",
          "Touch/Joystick"
        ],
        "pressThreshold": 0.9
      },
      {
        "name": "Crouch",
        "type": "button",
        "bindings": [
          "Keyboard/KeyC",
          "Keyboard/ControlLeft",
          "Gamepad/ButtonEast"
        ]
      },
      {
        "name": "Attack",
        "type": "button",
        "bindings": [
          "Mouse/LeftButton",
          "Gamepad/ButtonNorth",
          "Gamepad/RightTrigger"
        ]
      },
      {
        "name": "HeavyAttack",
        "type": "button",
        "bindings": [
          "Mouse/RightButton",
          "Keyboard/KeyR"
        ]
      },
      {
        "name": "Breath",
        "type": "button",
        "bindings": [
          "Keyboard/KeyF",
          "Gamepad/RightTrigger"
        ]
      },
      {
        "name": "DragonSense",
        "type": "button",
        "bindings": [
          "Keyboard/KeyC",
          "Gamepad/LeftTrigger"
        ]
      },
      {
        "name": "Interact",
        "type": "button",
        "bindings": [
          "Keyboard/KeyE",
          "Keyboard/KeyF",
          "Gamepad/ButtonWest"
        ]
      }
    ],
    "touch": {
      "enabled": "auto",
      "joystick": {
        "side": "left",
        "mode": "floating",
        "radius": 64
      },
      "look": {
        "enabled": true,
        "area": "right-half",
        "sensitivity": 1
      },
      "opacity": 0.6,
      "safeArea": true,
      "scale": "auto",
      "buttons": [
        {
          "id": "Jump",
          "action": "Jump",
          "label": "JUMP",
          "icon": "jump",
          "behavior": "hold",
          "anchor": "bottom-right",
          "unit": "px",
          "x": 24,
          "y": 32,
          "size": 72
        },
        {
          "id": "Attack",
          "action": "Attack",
          "label": "ATK",
          "icon": "attack",
          "behavior": "tap",
          "anchor": "bottom-right",
          "unit": "px",
          "x": 112,
          "y": 48,
          "size": 60
        },
        {
          "id": "Sprint",
          "action": "Sprint",
          "label": "RUN",
          "icon": "run",
          "behavior": "hold",
          "anchor": "bottom-right",
          "unit": "px",
          "x": 40,
          "y": 120,
          "size": 52
        },
        {
          "id": "Interact",
          "action": "Interact",
          "label": "USE",
          "icon": "use",
          "behavior": "tap",
          "anchor": "bottom-right",
          "unit": "px",
          "x": 120,
          "y": 128,
          "size": 52
        },
        {
          "id": "TurnLeft",
          "action": "Turn",
          "value": -1,
          "label": "Q",
          "icon": "turn-left",
          "anchor": "bottom-left",
          "unit": "px",
          "x": 24,
          "y": 190,
          "size": 44
        },
        {
          "id": "TurnRight",
          "action": "Turn",
          "label": "E",
          "icon": "turn-right",
          "anchor": "bottom-left",
          "unit": "px",
          "x": 80,
          "y": 190,
          "size": 44
        },
        {
          "id": "Breath",
          "action": "Breath",
          "label": "BREATH",
          "icon": "shoot",
          "behavior": "tap",
          "anchor": "bottom-right",
          "unit": "px",
          "x": 115,
          "y": 185,
          "size": 50,
          "color": "#3b82f6"
        },
        {
          "id": "HeavyAttack",
          "action": "HeavyAttack",
          "label": "TAIL",
          "icon": "sword",
          "behavior": "tap",
          "anchor": "bottom-right",
          "unit": "px",
          "x": 180,
          "y": 115,
          "size": 50,
          "color": "#8b5cf6"
        },
        {
          "id": "DragonSense",
          "action": "DragonSense",
          "label": "SENSE",
          "icon": "dash",
          "behavior": "toggle",
          "anchor": "top-right",
          "unit": "px",
          "x": 20,
          "y": 60,
          "size": 46,
          "color": "#eab308"
        }
      ]
    }
  },
  "services": [],
  "scenesInBuild": [
    "scenes/Main.lscene"
  ],
  "exportPresets": [
    {
      "id": "preset-windows-desktop",
      "name": "Windows Desktop",
      "platform": "windows",
      "backend": "linden",
      "arch": [
        "x64"
      ],
      "output": "build/windows/LegendOfMOON.exe",
      "mode": "release",
      "appName": "Legend Of MOON"
    },
    {
      "id": "preset-macos-desktop",
      "name": "macOS",
      "platform": "macos",
      "backend": "linden",
      "arch": [
        "universal"
      ],
      "output": "build/mac/LegendOfMOON.dmg",
      "mode": "release",
      "appName": "Legend Of MOON"
    },
    {
